static ResultRecord parse_result_line(const std::string &line) {
    auto v = split_csv_line(line);
    if (v.size() < 10) throw std::runtime_error("Bad result shard line: " + line);
    ResultRecord r;
    r.trial = std::stoi(v[0]);
    r.comp = std::stoi(v[1]);
    r.run = std::stoi(v[2]);
    r.temp_idx = std::stoi(v[3]);
